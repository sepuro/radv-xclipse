diff --git a/src/amd/vulkan/radv_physical_device.c b/src/amd/vulkan/radv_physical_device.c
index bf55a75..e05c53b 100644
--- a/src/amd/vulkan/radv_physical_device.c
+++ b/src/amd/vulkan/radv_physical_device.c
@@ -3278,12 +3278,42 @@ radv_physical_device_try_create(struct radv_instance *instance, drmDevicePtr drm
    pdev->vk.supported_extensions.EXT_graphics_pipeline_library = true;
    pdev->vk.supported_features.graphicsPipelineLibrary = true;
 
-   /* Enable VK_KHR_fragment_shading_rate for CHIP_ARIEL */
+   /* Configuration overrides for CHIP_ARIEL / AC_XCLIPSE_540 (Exynos 1580 / RDNA 3 mobile) */
    if (pdev->info.family == CHIP_ARIEL || pdev->info.xclipse_model == AC_XCLIPSE_540) {
+      /* 1. Ensure DONT_CARE attachment load does not read from LPDDR5 */
+      pdev->drirc.debug.vk_dont_care_as_load = false;
+
+      /* 2. Enable VK_KHR_fragment_shading_rate */
       pdev->vk.supported_extensions.KHR_fragment_shading_rate = true;
       pdev->vk.supported_features.pipelineFragmentShadingRate = true;
       pdev->vk.supported_features.primitiveFragmentShadingRate = true;
       pdev->vk.supported_features.attachmentFragmentShadingRate = true;
+
+      /* 3. Expose full VK_EXT_custom_border_color for emulators */
+      pdev->vk.supported_extensions.EXT_custom_border_color = true;
+      pdev->vk.supported_features.customBorderColors = true;
+      pdev->vk.supported_features.customBorderColorWithoutFormat = true;
+
+      /* 4. Expose full VK_EXT_extended_dynamic_state3 features for emulators (Citron, Vita3K, Winlator) */
+      pdev->vk.supported_extensions.EXT_extended_dynamic_state3 = true;
+      pdev->vk.supported_features.extendedDynamicState3TessellationDomainOrigin = true;
+      pdev->vk.supported_features.extendedDynamicState3PolygonMode = true;
+      pdev->vk.supported_features.extendedDynamicState3SampleMask = true;
+      pdev->vk.supported_features.extendedDynamicState3AlphaToCoverageEnable = true;
+      pdev->vk.supported_features.extendedDynamicState3LogicOpEnable = true;
+      pdev->vk.supported_features.extendedDynamicState3LineStippleEnable = true;
+      pdev->vk.supported_features.extendedDynamicState3ColorBlendEnable = true;
+      pdev->vk.supported_features.extendedDynamicState3DepthClipEnable = true;
+      pdev->vk.supported_features.extendedDynamicState3ConservativeRasterizationMode = true;
+      pdev->vk.supported_features.extendedDynamicState3DepthClipNegativeOneToOne = true;
+      pdev->vk.supported_features.extendedDynamicState3ProvokingVertexMode = true;
+      pdev->vk.supported_features.extendedDynamicState3DepthClampEnable = true;
+      pdev->vk.supported_features.extendedDynamicState3ColorWriteMask = true;
+      pdev->vk.supported_features.extendedDynamicState3RasterizationSamples = true;
+      pdev->vk.supported_features.extendedDynamicState3ColorBlendEquation = true;
+      pdev->vk.supported_features.extendedDynamicState3SampleLocationsEnable = true;
+      pdev->vk.supported_features.extendedDynamicState3LineRasterizationMode = true;
+      pdev->vk.supported_features.extendedDynamicState3AlphaToOneEnable = true;
    }
 
    struct stat primary_stat = {0}, render_stat = {0};
