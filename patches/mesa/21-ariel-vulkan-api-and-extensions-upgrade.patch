@@ -2159,9 +2159,9 @@ radv_get_physical_device_properties(struct radv_physical_device *pdev)
 
    pdev->vk.properties = (struct vk_properties){
 #ifdef ANDROID_STRICT
-      .apiVersion = RADV_API_VERSION,
+      .apiVersion = (pdev->info.family == CHIP_ARIEL) ? VK_MAKE_API_VERSION(0, 1, 4, VK_HEADER_VERSION) : RADV_API_VERSION,
