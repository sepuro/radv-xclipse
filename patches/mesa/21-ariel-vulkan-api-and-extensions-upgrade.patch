       /* Xclipse 920: report Samsung's vendor ID (0x144d) like the vendor ICD. With AMD's 0x1002
@@ -3287,6 +3287,9 @@ radv_physical_device_try_create(struct radv_instance *instance, drmDevicePtr drm
 
    /* Configuration overrides for CHIP_ARIEL / AC_XCLIPSE_540 (Exynos 1580 / RDNA 3 mobile) */
    if (pdev->info.family == CHIP_ARIEL || pdev->info.xclipse_model == AC_XCLIPSE_540) {
+      /* Expose latest Vulkan 1.4 API version supported by the tree */
+      pdev->vk.properties.apiVersion = VK_MAKE_API_VERSION(0, 1, 4, VK_HEADER_VERSION);
+
       /* 1. Ensure DONT_CARE attachment load does not read from LPDDR5 */
       pdev->drirc.debug.vk_dont_care_as_load = false;
 
@@ -3327,6 +3330,51 @@ radv_physical_device_try_create(struct radv_instance *instance, drmDevicePtr drm
       pdev->vk.supported_features.workgroupMemoryExplicitLayoutScalarBlockLayout = true;
       pdev->vk.supported_features.workgroupMemoryExplicitLayout8BitAccess = true;
       pdev->vk.supported_features.workgroupMemoryExplicitLayout16BitAccess = true;
+
+      /* 6. Unlock modern Vulkan 1.3 / 1.4 core extensions and features on GFX11 */
+      pdev->vk.supported_extensions.KHR_maintenance5 = true;
+      pdev->vk.supported_features.maintenance5 = true;
+
+      pdev->vk.supported_extensions.KHR_maintenance6 = true;
+      pdev->vk.supported_features.maintenance6 = true;
+
+      pdev->vk.supported_extensions.KHR_dynamic_rendering_local_read = true;
+      pdev->vk.supported_features.dynamicRenderingLocalRead = true;
+
+      pdev->vk.supported_extensions.KHR_map_memory2 = true;
+
+      pdev->vk.supported_extensions.EXT_shader_object = true;
+      pdev->vk.supported_features.shaderObject = true;
+
+      pdev->vk.supported_extensions.EXT_attachment_feedback_loop_layout = true;
+      pdev->vk.supported_features.attachmentFeedbackLoopLayout = true;
+
+      pdev->vk.supported_extensions.EXT_attachment_feedback_loop_dynamic_state = true;
+      pdev->vk.supported_features.attachmentFeedbackLoopDynamicState = true;
+
+      pdev->vk.supported_extensions.KHR_index_type_uint8 = true;
+      pdev->vk.supported_features.indexTypeUint8 = true;
+
+      pdev->vk.supported_extensions.KHR_vertex_attribute_divisor = true;
+      pdev->vk.supported_features.vertexAttributeInstanceRateDivisor = true;
+      pdev->vk.supported_features.vertexAttributeInstanceRateZeroDivisor = true;
+
+      pdev->vk.supported_extensions.KHR_line_rasterization = true;
+      pdev->vk.supported_features.rectangularLines = true;
+      pdev->vk.supported_features.bresenhamLines = true;
+      pdev->vk.supported_features.smoothLines = true;
+
+      pdev->vk.supported_extensions.KHR_load_store_op_none = true;
+
+      pdev->vk.supported_extensions.KHR_shader_subgroup_rotate = true;
+      pdev->vk.supported_features.shaderSubgroupRotate = true;
+      pdev->vk.supported_features.shaderSubgroupRotateClustered = true;
+
+      pdev->vk.supported_extensions.KHR_shader_expect_assume = true;
+      pdev->vk.supported_features.shaderExpectAssume = true;
+
+      pdev->vk.supported_extensions.KHR_shader_float_controls2 = true;
+      pdev->vk.supported_features.shaderFloatControls2 = true;
    }
 
    struct stat primary_stat = {0}, render_stat = {0};
