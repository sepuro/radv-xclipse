diff --git a/src/amd/vulkan/radv_formats.c b/src/amd/vulkan/radv_formats.c
index ea15dd4..5596677 100644
--- a/src/amd/vulkan/radv_formats.c
+++ b/src/amd/vulkan/radv_formats.c
@@ -449,6 +449,12 @@ radv_xclipse_is_native_etc2(const struct radv_physical_device *pdev, VkFormat fo
 bool
 radv_is_format_emulated(const struct radv_physical_device *pdev, VkFormat format)
 {
+   /* For CHIP_ARIEL / Xclipse 540, native ASTC LDR and ETC2/EAC formats are
+    * decoded directly by the TMU hardware units and must never fall back to
+    * slow software/compute-shader emulation. */
+   if (radv_xclipse_is_native_astc(pdev, format) || radv_xclipse_is_native_etc2(pdev, format))
+      return false;
+
    if (pdev->emulate_etc2 && vk_texcompress_etc2_emulation_format(format) != VK_FORMAT_UNDEFINED)
       return true;
 
