     * build hang predates that and is untested since. */
diff --git a/src/amd/vulkan/radv_buffer_view.c b/src/amd/vulkan/radv_buffer_view.c
index ee42349..fc33b13 100644
--- a/src/amd/vulkan/radv_buffer_view.c
+++ b/src/amd/vulkan/radv_buffer_view.c
@@ -87,6 +87,13 @@ radv_CreateBufferView(VkDevice _device, const VkBufferViewCreateInfo *pCreateInf
    radv_make_texel_buffer_descriptor(device, buffer->vk.device_address + view->vk.offset, view->vk.format,
                                      view->vk.range, view->state);
 
+   const struct radv_physical_device *pdev = radv_device_physical(device);
+   if (buffer->bo && pdev->info.family == CHIP_ARIEL) {
+      if (!buffer->bo->vram_no_cpu_access || (buffer->bo->initial_domain & RADEON_DOMAIN_GTT)) {
+         view->state[3] |= (1u << 26);
+      }
+   }
+
    *pView = radv_buffer_view_to_handle(view);
 
    return VK_SUCCESS;
diff --git a/src/amd/vulkan/radv_descriptors.h b/src/amd/vulkan/radv_descriptors.h
index ee39a65..cee3488 100644
--- a/src/amd/vulkan/radv_descriptors.h
+++ b/src/amd/vulkan/radv_descriptors.h
@@ -84,6 +84,18 @@ radv_write_buffer_descriptor_impl(struct radv_device *device, VkDescriptorType d
    }
 
    radv_write_buffer_descriptor(device, descriptor_type, dst, va, range);
+
+   const struct radv_physical_device *pdev = radv_device_physical(device);
+   if (buffer && buffer->bo && pdev->info.family == CHIP_ARIEL) {
+      /* Ariel (Xclipse 540): GL2 cache retention policy.
+       * For host-visible streaming buffers (not pure VRAM/device-local, or CPU accessible),
+       * set LLC_NOALLOC in rsrc_word3 (bit 26) so dynamic uniform/vertex data streamed
+       * from CPU does not thrash or evict texture and color/depth cache lines from the small GL2.
+       */
+      if (!buffer->bo->vram_no_cpu_access || (buffer->bo->initial_domain & RADEON_DOMAIN_GTT)) {
+         dst[3] |= (1u << 26);
+      }
+   }
 }
 
 static ALWAYS_INLINE void
diff --git a/src/amd/vulkan/radv_formats.c b/src/amd/vulkan/radv_formats.c
index ea15dd4..5596677 100644
--- a/src/amd/vulkan/radv_formats.c
+++ b/src/amd/vulkan/radv_formats.c
@@ -449,6 +449,12 @@ radv_xclipse_is_native_etc2(const struct radv_physical_device *pdev, VkFormat fo
 bool
 radv_is_format_emulated(const struct radv_physical_device *pdev, VkFormat format)
 {
+   /* For CHIP_ARIEL / Xclipse 540, native ASTC LDR and ETC2/EAC formats are
+    * decoded directly by the TMU hardware units and must never fall back to
+    * slow software/compute-shader emulation. */
+   if (radv_xclipse_is_native_astc(pdev, format) || radv_xclipse_is_native_etc2(pdev, format))
+      return false;
+
    if (pdev->emulate_etc2 && vk_texcompress_etc2_emulation_format(format) != VK_FORMAT_UNDEFINED)
       return true;
 
