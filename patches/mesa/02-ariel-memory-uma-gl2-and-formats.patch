diff --git a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c
index 9e6a4ce..525578f 100644
--- a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c
+++ b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c
@@ -345,6 +345,15 @@ radv_amdgpu_cs_get_initial_size(struct radv_amdgpu_winsys *ws, enum amd_ip_type
 {
    const uint32_t ib_alignment = ws->info.ip[ip_type].ib_alignment;
    assert(util_is_power_of_two_nonzero(ib_alignment));
+
+   /* For CHIP_ARIEL (Xclipse 540 / Exynos 1580), increase the initial CS Indirect Buffer (IB)
+    * pre-allocation size to reduce dynamic chaining and reallocation overhead during frames
+    * with high draw-call density, without modifying synchronization ioctls or timeouts. */
+   if (ws->info.family == CHIP_ARIEL || ws->info.xclipse_model == AC_XCLIPSE_540) {
+      if (ip_type == AMD_IP_GFX || ip_type == AMD_IP_COMPUTE)
+         return align(32 * 1024 * 4, ib_alignment);
+   }
+
    return align(20 * 1024 * 4, ib_alignment);
 }
 
@@ -1662,14 +1671,18 @@ radv_amdgpu_ctx_create(struct radeon_winsys *_ws, enum radeon_ctx_priority prior
    if (!ctx)
       return VK_ERROR_OUT_OF_HOST_MEMORY;
 
-   /* Elevate priority for 3D workloads on Samsung Xclipse / CHIP_ARIEL */
-   if ((ws->info.family == CHIP_ARIEL || ws->info.xclipse_model != AC_XCLIPSE_NONE) &&
-       priority == RADEON_CTX_PRIORITY_MEDIUM) {
-      r = ac_drm_cs_ctx_create2(ws->dev, AMDGPU_CTX_PRIORITY_HIGH, &ctx->ctx_handle);
-      if (r == 0)
-         amdgpu_priority = AMDGPU_CTX_PRIORITY_HIGH;
-      else
+   /* Force high context priority for 3D workloads on Samsung Xclipse / CHIP_ARIEL
+    * to prevent the kernel DVFS governor from dropping GPU frequencies during heavy frames. */
+   if (ws->info.family == CHIP_ARIEL || ws->info.xclipse_model != AC_XCLIPSE_NONE) {
+      uint32_t target_priority = (priority == RADEON_CTX_PRIORITY_REALTIME) ?
+                                 AMDGPU_CTX_PRIORITY_VERY_HIGH : AMDGPU_CTX_PRIORITY_HIGH;
+      r = ac_drm_cs_ctx_create2(ws->dev, target_priority, &ctx->ctx_handle);
+      if (r == 0) {
+         amdgpu_priority = target_priority;
+      } else {
+         amdgpu_priority = radeon_to_amdgpu_priority(priority);
          r = ac_drm_cs_ctx_create2(ws->dev, amdgpu_priority, &ctx->ctx_handle);
+      }
    } else {
       r = ac_drm_cs_ctx_create2(ws->dev, amdgpu_priority, &ctx->ctx_handle);
    }
