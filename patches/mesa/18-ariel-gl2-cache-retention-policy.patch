diff --git a/src/amd/vulkan/radv_descriptors.h b/src/amd/vulkan/radv_descriptors.h
index ee39a65..cee3488 100644
--- a/src/amd/vulkan/radv_descriptors.h
+++ b/src/amd/vulkan/radv_descriptors.h
@@ -84,6 +84,18 @@ radv_write_buffer_descriptor_impl(struct radv_device *device, VkDescriptorType d
    }
 
    radv_write_buffer_descriptor(device, descriptor_type, dst, va, range);
+
+   const struct radv_physical_device *pdev = radv_device_physical(device);
+   if (buffer && buffer->bo && pdev->info.family == CHIP_ARIEL) {
+      /* Ariel (Xclipse 540): GL2 cache retention policy.
+       * For host-visible streaming buffers (not pure VRAM/device-local, or CPU accessible),
+       * set LLC_NOALLOC in rsrc_word3 (bit 26) so dynamic uniform/vertex data streamed
+       * from CPU does not thrash or evict texture and color/depth cache lines from the small GL2.
+       */
+      if (!buffer->bo->vram_no_cpu_access || (buffer->bo->initial_domain & RADEON_DOMAIN_GTT)) {
+         dst[3] |= (1u << 26);
+      }
+   }
