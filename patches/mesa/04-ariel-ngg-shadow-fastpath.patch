diff --git a/src/amd/vulkan/radv_shader.c b/src/amd/vulkan/radv_shader.c
index 1df19ed..cebf804 100644
--- a/src/amd/vulkan/radv_shader.c
+++ b/src/amd/vulkan/radv_shader.c
@@ -1048,6 +1048,10 @@ radv_consider_culling(const struct radv_compiler_info *compiler_info, struct nir
    if (info->vs.has_prolog)
       return false;
 
+   /* Avoid NGG software culling overhead on CHIP_ARIEL (2 WGPs / 4 CUs geometry bottleneck). */
+   if (compiler_info->key.family == CHIP_ARIEL)
+      return false;
+
    if (!compiler_info->key.use_ngg_culling)
       return false;
 
diff --git a/src/amd/vulkan/radv_shader_info.c b/src/amd/vulkan/radv_shader_info.c
index ea5a415..5a8a8f6 100644
--- a/src/amd/vulkan/radv_shader_info.c
+++ b/src/amd/vulkan/radv_shader_info.c
@@ -1393,14 +1393,23 @@ radv_determine_ngg_settings(const struct radv_compiler_info *compiler_info, stru
       num_vertices_per_prim = mesa_vertices_per_prim(ngg_stage->nir->info.gs.output_primitive);
    }
 
-   ngg_stage->info.has_ngg_culling = radv_consider_culling(compiler_info, ngg_stage->nir, ps_inputs_read,
-                                                           num_vertices_per_prim, &ngg_stage->info, gfx_state);
+   /* Avoid NGG software culling overhead on CHIP_ARIEL (2 WGPs / 4 CUs geometry bottleneck). */
+   if (compiler_info->key.family == CHIP_ARIEL) {
+      ngg_stage->info.has_ngg_culling = false;
+   } else {
+      ngg_stage->info.has_ngg_culling = radv_consider_culling(compiler_info, ngg_stage->nir, ps_inputs_read,
+                                                              num_vertices_per_prim, &ngg_stage->info, gfx_state);
+   }
 
    if (ngg_stage->stage != MESA_SHADER_GEOMETRY) {
       nir_function_impl *impl = nir_shader_get_entrypoint(ngg_stage->nir);
       ngg_stage->info.has_ngg_early_prim_export =
          compiler_info->ac->gfx_level < GFX11 && exec_list_is_singular(&impl->body);
 
+      /* Detect depth-only / shadow map pass (no color attachments bound or written) */
+      const bool is_depth_only = (!fs_stage || fs_stage->info.ps.colors_written == 0) &&
+                                 gfx_state->ps.epilog.spi_shader_col_format == 0;
+
       /* NGG passthrough requires that the input and output topologies, vertex counts, and primitive
        * counts are the same. NGG passthrough doesn't care about anything else the shader does,
        * and the shader can still cull by flipping the cull bit in primitive exports.
@@ -1414,8 +1423,13 @@ radv_determine_ngg_settings(const struct radv_compiler_info *compiler_info, stru
        * - Navi23 and later chips can optionally skip the gs_alloc_req message
        *
        * If switching NGG passthrough on/off leads to unnecessary context rolls, we should stop using it.
+       * On CHIP_ARIEL, enable the NGG passthrough fastpath on depth-only / shadow passes.
        */
-      ngg_stage->info.is_ngg_passthrough = !ngg_stage->info.has_ngg_culling && !gfx_state->rs.rasterizer_discard;
+      if (compiler_info->key.family == CHIP_ARIEL && is_depth_only && !gfx_state->rs.rasterizer_discard) {
+         ngg_stage->info.is_ngg_passthrough = true;
+      } else {
+         ngg_stage->info.is_ngg_passthrough = !ngg_stage->info.has_ngg_culling && !gfx_state->rs.rasterizer_discard;
+      }
    }
 }
 
