diff --git a/src/amd/compiler/aco_shader_info.c b/src/amd/compiler/aco_shader_info.c
index c7cc77f..ebb905c 100644
--- a/src/amd/compiler/aco_shader_info.c
+++ b/src/amd/compiler/aco_shader_info.c
@@ -20,3 +20,21 @@ aco_compiler_ariel_select_wave_size(unsigned workgroup_size, unsigned shared_siz
 
    return 32;
 }
+
+/*
+ * Shadow pass and register pressure optimizer for CHIP_ARIEL (Xclipse 540 / 2 WGPs):
+ * For Vertex (NGG) and Fragment shaders processing depth-only or shadow projection workloads,
+ * bounds the target VGPR limit to 32 registers in Wave32 mode. This prevents register
+ * bank exhaustion and eliminates costly spills to system memory across the 4 CUs.
+ */
+uint16_t
+aco_compiler_ariel_tune_vgpr_limit(enum ac_hw_stage hw_stage, bool is_shadow, uint16_t current_limit)
+{
+   if (is_shadow || hw_stage == AC_HW_NEXT_GEN_GEOMETRY_SHADER) {
+      /* Keep shadow pass vertex and depth-only shaders bounded to 32 VGPRs for maximum occupancy */
+      return (current_limit > 32) ? 32 : current_limit;
+   } else if (hw_stage == AC_HW_PIXEL_SHADER) {
+      return (current_limit > 40) ? 40 : current_limit;
+   }
+   return current_limit;
+}
